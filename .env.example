# ==============================================================================
# BorngreatAccounting (BtAccounting) — Environment Configuration Template
# Your Accounting. Your Servers. Your Control.
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# --- Application Identity & Mode ----------------------------------------------
APP_NAME=BorngreatAccounting
APP_SHORT_NAME=BtAccounting
NODE_ENV=development
BASE_URL=http://localhost:80

# Full-access trial length for new Cloud organizations, in days.
FREE_TRIAL_DAYS=15

# --- App Proxy & Ports --------------------------------------------------------
PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443
PORT=3000

# --- Security & Authentication ------------------------------------------------
# Required secret used to sign authentication JWTs.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=change_me_generate_with_openssl_rand_base64_48

# Two-factor authentication (TOTP) encryption key at rest.
# Generate one with: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=
# Issuer name shown in authenticator apps.
TWO_FACTOR_ISSUER=BorngreatAccounting

# --- Database (MariaDB) -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=borngreat
DB_PASSWORD=borngreat_secret
DB_ROOT_PASSWORD=borngreat_root_secret
DB_CHARSET=utf8

# System database
SYSTEM_DB_NAME=borngreat_system
# SYSTEM_DB_USER=
# SYSTEM_DB_PASSWORD=
# SYSTEM_DB_CHARSET=

# Tenant databases prefix
TENANT_DB_NAME_PERFIX=borngreat_tenant_
# TENANT_DB_HOST=
# TENANT_DB_USER=
# TENANT_DB_PASSWORD=
# TENANT_DB_CHARSET=

# --- Redis Cache & Queue ------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_HOST=localhost
QUEUE_PORT=6379

# --- Gotenberg PDF Rendering Service ------------------------------------------
# Production (Docker network):
# GOTENBERG_URL=http://gotenberg:3000
# GOTENBERG_DOCS_URL=http://server:3000/public/
# Local Development:
GOTENBERG_URL=http://localhost:9000
GOTENBERG_DOCS_URL=http://host.docker.internal:3000/public/

# --- S3 / Garage Object Storage (Attachments & Documents) ---------------------
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://garage:3900
S3_BUCKET=borngreataccounting
S3_FORCE_PATH_STYLE=true

# Self-hosted Garage object storage secrets (openssl rand -hex 32)
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=borngreat_garage_admin_token

# --- ClickHouse Analytics Store (Optional) ------------------------------------
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=borngreat_clickhouse_secret
CLICKHOUSE_DATABASE=borngreat_analytics

# --- SMTP / Email Notifications -----------------------------------------------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=BorngreatAccounting
MAIL_FROM_ADDRESS=noreply@example.com

# --- Sign-up & Access Control -------------------------------------------------
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# --- API Throttling & Rate Limiting -------------------------------------------
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30

# --- Google OAuth ("Continue with Google", Optional) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTH_SUCCESS_REDIRECT_URL=http://localhost:4000/auth/google/callback
GOOGLE_AUTH_FAILURE_REDIRECT_URL=http://localhost:4000/auth/login

# --- Twilio SMS Integration (Optional) ----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Foreign Exchange Rate Service (Optional) ---------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# --- Plaid Banking Integration (Optional) -------------------------------------
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=
PLAID_CLIENT_NAME=BorngreatAccounting
PLAID_COUNTRY_CODES=US

# --- Stripe Payment & Billing Integration (Optional) --------------------------
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=https://example.com/preferences/payment-methods/stripe/callback

# --- Auto-Update Interval (Watchtower, Optional) ------------------------------
AUTO_UPDATE_INTERVAL=3600
