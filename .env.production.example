# ==============================================================================
# BorngreatAccounting (BtAccounting) — Production Environment Template
# Copy to .env before running `docker compose -f docker-compose.production.yml up -d`
# or use ./install.sh / .\install.ps1 to auto-generate strong cryptographic secrets.
# ==============================================================================

APP_NAME=BorngreatAccounting
APP_SHORT_NAME=BtAccounting
NODE_ENV=production
BASE_URL=http://localhost

PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443
PORT=3000

# REQUIRED: Replace with output of `openssl rand -base64 48`
APP_JWT_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=BorngreatAccounting

# MariaDB Production Settings (inside Docker network, DB_HOST is `mysql`)
DB_HOST=mysql
DB_PORT=3306
DB_USER=borngreat
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8
SYSTEM_DB_NAME=borngreat_system
TENANT_DB_NAME_PERFIX=borngreat_tenant_

# Redis Cache & Bull Queue
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_HOST=redis
QUEUE_PORT=6379

# Gotenberg PDF Rendering Service
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_DOCS_URL=http://server:3000/public/

# S3 / Garage Object Storage
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://garage:3900
S3_BUCKET=borngreataccounting
S3_FORCE_PATH_STYLE=true
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ClickHouse Analytics
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=borngreat_analytics

# SMTP Mail Configuration
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=BorngreatAccounting
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# Access & Throttling
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false
FREE_TRIAL_DAYS=15
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30
AUTO_UPDATE_INTERVAL=3600
