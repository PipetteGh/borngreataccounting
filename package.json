{
  "name": "borngreataccounting-monorepo",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "dev": "lerna run dev",
    "build": "lerna run build",
    "typecheck": "lerna run typecheck",
    "dev:webapp": "lerna run dev --scope \"@borngreataccounting/webapp\" --scope \"@borngreataccounting/utils\" --scope \"@borngreataccounting/pdf-templates\"",
    "build:webapp": "lerna run build --scope \"@borngreataccounting/webapp\" --scope \"@borngreataccounting/utils\" --scope \"@borngreataccounting/pdf-templates\" --scope \"@borngreataccounting/sdk-ts\"",
    "dev:server": "lerna run dev --scope \"@borngreataccounting/server\" --scope \"@borngreataccounting/utils\" --scope \"@borngreataccounting/pdf-templates\" --scope \"@borngreataccounting/email-components\"",
    "build:shared": "lerna run build --scope \"@borngreataccounting/utils\" --scope \"@borngreataccounting/pdf-templates\" --scope \"@borngreataccounting/email-components\" --scope \"@borngreataccounting/sdk-ts\"",
    "build:server": "lerna run build --scope \"@borngreataccounting/server\" --scope \"@borngreataccounting/utils\" --scope \"@borngreataccounting/pdf-templates\" --scope \"@borngreataccounting/email-components\"",
    "test": "lerna run test --scope \"@borngreataccounting/server\"",
    "test:watch": "lerna run test:watch",
    "test:e2e": "lerna run test:e2e --scope \"@borngreataccounting/server\"",
    "e2e:webapp": "playwright test",
    "screenshot:webapp": "playwright test --config playwright.screenshots.config.ts",
    "dev:debug": "lerna run dev:debug",
    "prepare": "husky install",
    "system:migrate:make": "lerna run cli:system:migrate:make --scope \"@borngreataccounting/server\"",
    "tenants:migrate:make": "lerna run cli:tenants:migrate:make --scope \"@borngreataccounting/server\"",
    "system:migrate:rollback": "lerna run cli:system:migrate:rollback --scope \"@borngreataccounting/server\"",
    "tenants:migrate:rollback": "lerna run cli:tenants:migrate:rollback --scope \"@borngreataccounting/server\"",
    "system:migrate:latest": "lerna run cli:system:migrate:latest --scope \"@borngreataccounting/server\"",
    "tenants:migrate:latest": "lerna run cli:tenants:migrate:latest --scope \"@borngreataccounting/server\"",
    "system:seed:latest": "lerna run cli:system:seed:latest --scope \"@borngreataccounting/server\"",
    "tenants:seed:latest": "lerna run cli:tenants:seed:latest --scope \"@borngreataccounting/server\"",
    "generate:sdk-types": "lerna run openapi:export --scope \"@borngreataccounting/server\" && lerna run generate --scope \"@borngreataccounting/sdk-ts\" && lerna run build --scope \"@borngreataccounting/sdk-ts\"",
    "stripe:sync-plans": "lerna run cli:stripe:sync-plans --scope \"@borngreataccounting/server\"",
    "format": "lerna run format",
    "format:check": "lerna run format:check",
    "lint": "lerna run lint",
    "lint:check": "lerna run lint:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@commitlint/config-lerna-scopes": "^17.4.2",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.32.3",
    "husky": "^8.0.3",
    "lerna": "^8.1.2",
    "pnpm": "^9.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "tsup": "^8.3.0"
  }
}
