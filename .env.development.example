# ==============================================================================
# BorngreatAccounting (BtAccounting) — Local Development Environment Template
# Copy to .env for local development with `pnpm run dev:server` & `pnpm run dev:webapp`
# ==============================================================================

APP_NAME=BorngreatAccounting
APP_SHORT_NAME=BtAccounting
NODE_ENV=development
BASE_URL=http://localhost:4000

PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443
PORT=3000

APP_JWT_SECRET=borngreat_local_dev_jwt_secret_key_do_not_use_in_prod_987654321
TWO_FACTOR_ENCRYPTION_KEY=borngreat_local_dev_totp_key_32b
TWO_FACTOR_ISSUER=BorngreatAccounting

DB_HOST=localhost
DB_PORT=3306
DB_USER=borngreat
DB_PASSWORD=borngreat
DB_ROOT_PASSWORD=root
DB_CHARSET=utf8
SYSTEM_DB_NAME=borngreat_system
TENANT_DB_NAME_PERFIX=borngreat_tenant_

REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_HOST=localhost
QUEUE_PORT=6379

GOTENBERG_URL=http://localhost:9000
GOTENBERG_DOCS_URL=http://host.docker.internal:3000/public/

S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=borngreataccounting
S3_FORCE_PATH_STYLE=true
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=borngreat_dev_admin_token

CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=borngreat_dev_ch_pass
CLICKHOUSE_DATABASE=borngreat_analytics

SIGNUP_DISABLED=false
SIGNUP_EMAIL_CONFIRMATION=false
FREE_TRIAL_DAYS=15
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=600
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=60
